  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_01
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Ng\u01B0\u1EDDi k\u1EC3 chuy\u1EC7n"
  title: "Ch\xE0ng trai b\u1ECB truy \u0111u\u1ED5i"
  content: "M\u1ED9t m\xECnh ch\u1EA1y tr\u1ED1n b\u1ECDn c\u01B0\u1EDBp t\xE0n b\u1EA1o,
    tim \u0111\u1EADp th\xECnh th\u1ECBch, b\u1EE5i \u0111\u01B0\u1EDDng m\xF9 m\u1ECBt
    theo t\u1EEBng b\u01B0\u1EDBc ch\u1EA1y. Nh\u1EEFng ti\u1EBFng la h\xE9t vang
    v\u1ECDng kh\u1EAFp ng\u1ECDn \u0111\u1ED3i, khi\u1EBFn ch\xE0ng trai c\xE0ng
    ph\u1EA3i lao \u0111i nhanh h\u01A1n."
  portrait: {fileID: 0}
