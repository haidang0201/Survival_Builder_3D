  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "PH\xD3 L\xDD"
  title: "Khai th\xE1c t\xE0i nguy\xEAn"
  content: "Ng\u01B0\u1EDDi d\xE2n s\u1EBD t\u1EF1 ra \u0111\u1ED3ng, v\xE0o r\u1EEBng,
    khai th\xE1c \u0111\xE1, l\xFAa, g\u1ED7. H\u1ECD mang v\u1EC1 kho ri\xEAng tr\u01B0\u1EDBc,
    r\u1ED3i m\u1ED9t nh\xF3m kh\xE1c s\u1EBD gom t\u1EA5t c\u1EA3 v\u1EC1 kho chung
    \u2014 n\u01A1i c\u1EADu c\xF3 th\u1EC3 d\xF9ng \u0111\u1EC3 x\xE2y d\u1EF1ng."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
