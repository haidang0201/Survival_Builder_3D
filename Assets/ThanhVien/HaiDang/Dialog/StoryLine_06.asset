  m_Name: StoryLine_06
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "PH\xD3 L\xDD"
  title: "B\u1ECDn c\u01B0\u1EDBp b\xF3c quay tr\u1EDF l\u1EA1i"
  content: "Nh\u01B0ng s\u1EF1 y\xEAn b\xECnh kh\xF4ng k\xE9o d\xE0i. B\u1ECDn c\u01B0\u1EDBp
    quay l\u1EA1i, l\u1EA7n n\xE0y \u0111\xF4ng h\u01A1n, hung h\xE3n h\u01A1n \u2014
    nh\u01B0 mu\u1ED1n nh\u1EAFc ch\xFAng t\xF4i r\u1EB1ng m\u1ECDi th\u1EE9 v\u1EEBa
    g\xE2y d\u1EF1ng c\xF3 th\u1EC3 s\u1EE5p \u0111\u1ED5 b\u1EA5t c\u1EE9 l\xFAc
    n\xE0o."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
