  speakerName: "PH\xD3 L\xDD"
  title: "Giao di\u1EC7n ch\xEDnh"
  content: "M\u1ECDi quy\u1EBFt \u0111\u1ECBnh c\u1EE7a c\u1EADu s\u1EBD b\u1EAFt
    \u0111\u1EA7u t\u1EEB hai n\u01A1i: thanh t\xE0i nguy\xEAn \u1EDF g\xF3c m\xE0n
    h\xECnh, cho bi\u1EBFt ch\xFAng ta \u0111ang c\xF3 g\xEC \u2014 v\xE0 menu x\xE2y
    d\u1EF1ng ngay d\u01B0\u1EDBi \u0111\xF3, n\u01A1i m\u1ECDi k\u1EBF ho\u1EA1ch
    \u0111\u01B0\u1EE3c v\u1EA1ch ra."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
