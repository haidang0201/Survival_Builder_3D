  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_07
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Tr\u01B0\u1EDFng l\xE0ng"
  title: "N\u1EA3y sinh quy\u1EBFt t\xE2m ti\xEAu di\u1EC7t b\u1ECDn c\u01B0\u1EDBp"
  content: "Kh\xF4ng th\u1EC3 m\xE3i s\u1ED1ng trong s\u1EE3 h\xE3i. Tr\u01B0\u1EDFng
    l\xE0ng h\u1ED9i \xFD v\u1EDBi ch\xE0ng trai, l\u1EADp k\u1EBF ho\u1EA1ch chi\u1EBFn
    \u0111\u1EA5u. \xD4ng gi\u01A1 tay ra hi\u1EC7u, d\xE2n l\xE0ng h\xF4 to quy\u1EBFt
    t\xE2m. N\u1ED7i s\u1EE3 b\u1ECB thay b\u1EB1ng tinh th\u1EA7n ki\xEAn c\u01B0\u1EDDng
    v\xE0 kh\xE1t khao tr\u1EA3 l\u1EA1i b\xECnh y\xEAn."
  portrait: {fileID: 0}
