  m_Name: StoryLine_04
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Tr\u01B0\u1EDFng l\xE0ng"
  title: "T\u1EF1 tay d\u1EF1ng x\xE2y l\u1EA1i nh\xE0 c\u1EEDa"
  content: "C\xF9ng d\xE2n l\xE0ng g\xF3p s\u1EE9c, t\u1EEBng vi\xEAn g\u1EA1ch t\u1EEBng
    t\u1EA5m v\xE1n \u0111\u01B0\u1EE3c \u0111\u1EB7t l\u1EA1i v\xE0o \u0111\xFAng
    ch\u1ED7. Tr\u01B0\u1EDFng l\xE0ng kh\xF4ng ng\u1EA1i b\u1EA9n tay, \u0111\xF4i
    m\u1EAFt lu\xF4n ch\u0103m ch\xFA h\u01B0\u1EDBng v\u1EC1 t\u01B0\u01A1ng lai.
    \xC2m thanh b\xFAa, ti\u1EBFng c\u01B0\u1EDDi v\xE0 l\u1EDDi \u0111\u1ED9ng vi\xEAn
    vang l\xEAn kh\u1EAFp n\u01A1i."
  portrait: {fileID: 0}
