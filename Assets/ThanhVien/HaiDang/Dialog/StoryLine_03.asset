  m_Name: StoryLine_03
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Ph\xF3 l\xFD"
  title: "Quy\u1EBFt \u1EDF l\u1EA1i"
  content: "L\u1EBD ra c\u1EADu ta c\xF3 th\u1EC3 ch\u1EA1y ti\u1EBFp, t\xECm m\u1ED9t
    n\u01A1i an to\xE0n h\u01A1n. Nh\u01B0ng c\u1EADu ta \u0111\xE3 kh\xF4ng l\xE0m
    v\u1EADy. T\xF4i ngh\u0129, ch\xEDnh kho\u1EA3nh kh\u1EAFc \u0111\xF3, m\u1ED9t
    \u0111i\u1EC1u g\xEC \u0111\xF3 trong c\u1EADu ta \u0111\xE3 thay \u0111\u1ED5i."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
