  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_08
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Ph\xF3 l\xFD"
  title: "Trao quy\u1EC1n"
  content: "Tr\u01B0\u1EDFng l\xE0ng g\u1ECDi c\u1EADu ta \u0111\u1EBFn. 'Ta \u0111\xE3
    gi\xE0 r\u1ED3i... ng\xF4i l\xE0ng n\xE0y, ta giao l\u1EA1i cho con. H\xE3y ti\xEAu
    di\u1EC7t b\u1ECDn c\u01B0\u1EDBp, m\u1EDF r\u1ED9ng l\xE3nh th\u1ED5, mang l\u1EA1i
    b\xECnh y\xEAn cho d\xE2n l\xE0ng.' C\u1EADu ta g\u1EADt \u0111\u1EA7u \u2014
    v\xE0 t\u1EEB \u0111\xF3, c\xE2u chuy\u1EC7n c\u1EE7a l\xE0ng ch\xFAng t\xF4i
    b\u01B0\u1EDBc sang m\u1ED9t trang m\u1EDBi."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
