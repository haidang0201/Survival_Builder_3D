--- !u!114 &2690467848542677885
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7116683031281585286}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27607508e02395e4d91d80f03ead03f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NarrationController
  backgroundImage: {fileID: 7106552013231643107}
  fadeImageOverlay: {fileID: 3616098641279717992}
  narrationText: {fileID: 7320328031080389345}
  mainCamera: {fileID: 0}
  audioSource: {fileID: 7760116277747191579}
  typingSpeed: 0.05
  defaultFadeDuration: 0.8
  storySteps:
  - backgroundSprite: {fileID: 21300000, guid: 5637637c2ee59f3438206f139dcbef9e, type: 3}
    transition: 1
    textContent: "\"Tr\u01B0\u1EDBc khi ng\u1ECDn l\u1EEDa \u0111\u1EA7u ti\xEAn
      \u0111\u01B0\u1EE3c th\u1EAFp l\xEAn...\""
    voiceOrSFX: {fileID: 8300000, guid: c30b63e96e724224d9c353270c26579b, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: 5637637c2ee59f3438206f139dcbef9e, type: 3}
    transition: 1
    textContent: "\"...thung l\u0169ng n\xE0y l\xE0 v\u01B0\u01A1ng qu\u1ED1c \u0111\u1ED9c
      t\xF4n c\u1EE7a \u0111\u1EA1i ng\xE0n.\""
    voiceOrSFX: {fileID: 8300000, guid: 1d4a94713a6b834448f498f2e51d9c04, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: 5637637c2ee59f3438206f139dcbef9e, type: 3}
    transition: 0
    textContent: "\"N\u01A1i s\u01B0\u01A1ng m\xF9 che gi\u1EA5u nh\u1EEFng b\xED
      m\u1EADt r\xEAu phong, v\xE0 th\u1EDDi gian d\u01B0\u1EDDng nh\u01B0 ng\u1EEBng
      ch\u1EA3y.\""
    voiceOrSFX: {fileID: 8300000, guid: 74766c461f5d53d4c876f47d7a3549a1, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: 4ca3eea7e1f41534b8c7a23251b7b020, type: 3}
    transition: 1
    textContent: "\"Cho \u0111\u1EBFn khi h\u1ECD \u0111\u1EBFn. Nh\u1EEFng k\u1EBB
      mang theo khao kh\xE1t s\u1ED1ng m\xE3nh li\u1EC7t.\""
    voiceOrSFX: {fileID: 8300000, guid: 7b6abe8905b79f042a687fcb53002f71, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: f36280eb4fbbb8f4e9524c0b19a353e1, type: 3}
    transition: 1
    textContent: "B\u1EB1ng \u0111\xF4i b\xE0n tay tr\u1EAFng..."
    voiceOrSFX: {fileID: 8300000, guid: 1dd133f2ebf76ef4086765bad12e3f09, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: 1589a55061ecf424aae6fe2630cce570, type: 3}
    transition: 1
    textContent: "h\u1ECD \xE9p \u0111\u1EA1i ng\xE0n ph\u1EA3i nh\u01B0\u1EDDng
      ch\u1ED7 cho s\u1EF1 s\u1ED1ng.."
    voiceOrSFX: {fileID: 8300000, guid: e05b84dd8275509409ca91522fa02433, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: e51b359016642824aad2e3f2259af38c, type: 3}
    transition: 1
    textContent: "Nh\u01B0ng \u0111\u1EA1i ng\xE0n ch\u01B0a bao gi\u1EDD ng\u1EE7."
    voiceOrSFX: {fileID: 8300000, guid: f83e7bc98ad9f5e4299896bd9b698a6c, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: e51b359016642824aad2e3f2259af38c, type: 3}
    transition: 5
    textContent: "X\xE0o x\u1EA1c.."
    voiceOrSFX: {fileID: 8300000, guid: f8ddf8246e02e444cad6ab36439d18b6, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: e51b359016642824aad2e3f2259af38c, type: 3}
    transition: 2
    textContent: "Khi \xE1nh s\xE1ng t\u1EAFt l\u1ECBm, thung l\u0169ng l\u1ED9t
      b\u1ECF l\u1EDBp \xE1o hi\u1EC1n h\xF2a."
    voiceOrSFX: {fileID: 8300000, guid: 454d53176962d064eb4733ca2b76cd91, type: 3}
  - backgroundSprite: {fileID: 21300000, guid: 6ff8fad3d76f0e44cb124a90a4e557e8, type: 3}
    transition: 2
    textContent: "N\xF3 \u0111\xF2i l\u1EA1i nh\u1EEFng g\xEC thu\u1ED9c v\u1EC1
      b\xF3ng t\u1ED1i."
    voiceOrSFX: {fileID: 8300000, guid: 1d2596bbb14eb4c4b83652a31630ee4a, type: 3}
