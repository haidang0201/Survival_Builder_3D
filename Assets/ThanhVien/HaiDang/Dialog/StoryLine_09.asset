  m_Name: StoryLine_09
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Ph\xF3 l\xFD"
  title: "Ra m\u1EAFt"
  content: "C\xF2n t\xF4i \u2014 t\xF4i l\xE0 ng\u01B0\u1EDDi \u0111\xE3 \u1EDF \u0111\xE2y
    t\u1EEB nh\u1EEFng ng\xE0y \u0111\u1EA7u \u1EA5y, lo li\u1EC7u m\u1ECDi vi\u1EC7c
    l\u1EDBn nh\u1ECF trong l\xE0ng. T\u1EEB gi\u1EDD, t\xF4i s\u1EBD l\xE0 ng\u01B0\u1EDDi
    \u0111\u1ED3ng h\xE0nh c\xF9ng c\u1EADu, k\u1EC3 cho c\u1EADu nghe nh\u1EEFng
    g\xEC c\u1EADu c\u1EA7n bi\u1EBFt."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
