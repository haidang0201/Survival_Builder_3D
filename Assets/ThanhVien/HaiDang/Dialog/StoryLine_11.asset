  speakerName: "PH\xD3 L\xDD"
  title: "Giao di\u1EC7n ch\xEDnh"
  content: "Nh\xECn l\xEAn g\xF3c m\xE0n h\xECnh \u2014 \u0111\xF3 l\xE0 thanh t\xE0i
    nguy\xEAn: G\u1ED7, \u0110\xE1, L\xFAa. Ba th\u1EE9 \u0111\xF3 quy\u1EBFt \u0111\u1ECBnh
    l\xE0ng t\u1ED3n t\u1EA1i hay s\u1EE5p \u0111\u1ED5. Ngay d\u01B0\u1EDBi l\xE0
    menu x\xE2y d\u1EF1ng \u2014 n\u01A1i m\u1ECDi k\u1EBF ho\u1EA1ch b\u1EAFt \u0111\u1EA7u."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
