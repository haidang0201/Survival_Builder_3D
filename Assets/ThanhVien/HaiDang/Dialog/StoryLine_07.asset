  m_Name: StoryLine_07
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "PH\xD3 L\xDD"
  title: "N\u1EA3y sinh quy\u1EBFt t\xE2m ti\xEAu di\u1EC7t b\u1ECDn c\u01B0\u1EDBp"
  content: "\u0110\xEAm \u0111\xF3, t\xF4i th\u1EA5y c\u1EADu ta \u0111\u1EE9ng r\u1EA5t
    l\xE2u tr\u01B0\u1EDBc \u0111\u1ED1ng \u0111\u1ED5 n\xE1t c\u0169. Khi quay l\u1EA1i,
    \xE1nh m\u1EAFt c\u1EADu ta \u0111\xE3 kh\xE1c \u2014 kh\xF4ng c\xF2n l\xE0 s\u1EF1
    s\u1EE3 h\xE3i c\u1EE7a ng\xE0y \u0111\u1EA7u, m\xE0 l\xE0 m\u1ED9t quy\u1EBFt
    t\xE2m: ph\u1EA3i ch\u1EA5m d\u1EE9t n\u1ED7i \xE1m \u1EA3nh n\xE0y, m\xE3i m\xE3i."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
