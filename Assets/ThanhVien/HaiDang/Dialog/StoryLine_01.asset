  speakerName: "PH\xD3 L\xDD"
  title: "Ch\xE0ng trai b\u1ECB truy \u0111u\u1ED5i"
  content: "T\xF4i c\xF2n nh\u1EDB r\xF5 bu\u1ED5i chi\u1EC1u \u1EA5y. M\u1ED9t ch\xE0ng
    trai l\u1EA1 m\u1EB7t ch\u1EA1y b\u0103ng qua c\xE1nh \u0111\u1ED3ng, ph\xEDa
    sau l\xE0 ti\u1EBFng v\xF3 ng\u1EF1a c\u1EE7a b\u1ECDn c\u01B0\u1EDBp. Kh\xF4ng
    ai trong l\xE0ng bi\u1EBFt, ng\xE0y \u0111\xF3 s\u1EBD thay \u0111\u1ED5i t\u1EA5t
    c\u1EA3."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
