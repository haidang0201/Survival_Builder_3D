  m_Name: StoryLine_13
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Ph\xF3 l\xE0ng"
  title: "X\xE2y d\u1EF1ng & n\xE2ng c\u1EA5p"
  content: " \"Khi \u0111\u1EE7 t\xE0i nguy\xEAn, c\u1EADu c\xF3 th\u1EC3 d\u1EF1ng
    c\xF4ng tr\xECnh m\u1EDBi ho\u1EB7c n\xE2ng c\u1EA5p nh\xE0 \u1EDF, kho ch\u1EE9a.
    C\xE0ng n\xE2ng c\u1EA5p, l\xE0ng c\xE0ng ch\u1EE9a \u0111\u01B0\u1EE3c nhi\u1EC1u
    v\xE0 c\xF3 th\xEAm worker.\""
  portrait: {fileID: 0}
