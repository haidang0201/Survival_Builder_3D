  m_Name: StoryLine_08
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "PH\xD3 L\xDD"
  title: "Trao quy\u1EC1n"
  content: "Tr\u01B0\u1EDFng l\xE0ng g\u1ECDi c\u1EADu \u0111\u1EBFn v\xE0 n\xF3i:
    'Ta \u0111\xE3 gi\xE0. Ng\xF4i l\xE0ng n\xE0y \u2014 ta giao l\u1EA1i cho con.
    H\xE3y ti\xEAu di\u1EC7t b\u1ECDn c\u01B0\u1EDBp, m\u1EDF r\u1ED9ng l\xE3nh th\u1ED5,
    mang l\u1EA1i b\xECnh y\xEAn.' C\u1EADu g\u1EADt \u0111\u1EA7u."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
