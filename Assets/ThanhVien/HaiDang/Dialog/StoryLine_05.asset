  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_05
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Ng\u01B0\u1EDDi k\u1EC3 chuy\u1EC7n"
  title: "D\xE2n l\xE0ng s\u1ED1ng y\xEAn \u1ED5n tr\u1EDF l\u1EA1i"
  content: "Sau nhi\u1EC1u tu\u1EA7n v\u1EA5t v\u1EA3, ng\xF4i l\xE0ng d\u1EA7n h\u1ED3i
    sinh. Tr\u1EBB con ch\u1EA1y ch\u01A1i tr\xEAn \u0111\u01B0\u1EDDng l\xE0ng,
    ph\u1EE5 n\u1EEF n\u1EA5u \u0103n, \u0111\xE0n \xF4ng d\u1EF1ng th\xEAm c\xF4ng
    tr\xECnh. Ch\xE0ng trai tr\u1EDF th\xE0nh ch\u1ED7 d\u1EF1a, \u0111\u01B0\u1EE3c
    d\xE2n l\xE0ng tin t\u01B0\u1EDFng v\xE0 tr\xE2n tr\u1ECDng."
  portrait: {fileID: 0}
