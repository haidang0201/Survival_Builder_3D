  m_Name: StoryLine_12
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "PH\xD3 L\xDD"
  title: "Khai th\xE1c t\xE0i nguy\xEAn"
  content: "Worker s\u1EBD t\u1EF1 ra \u0111\u1ED3ng, v\xE0o r\u1EEBng khai th\xE1c.
    H\u1ECD mang v\u1EC1 kho ri\xEAng tr\u01B0\u1EDBc, r\u1ED3i nh\xF3m v\u1EADn
    chuy\u1EC3n gom v\u1EC1 kho t\u1ED5ng. C\u1EADu kh\xF4ng c\u1EA7n l\xE0m tay
    \u2014 ch\u1EC9 c\u1EA7n ph\xE2n c\xF4ng \u0111\xFAng ch\u1ED7."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
