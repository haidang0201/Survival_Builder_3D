  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_15
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "PH\xD3 L\xDD"
  title: "Nhi\u1EC7m v\u1EE5"
  content: "T\xF4i \u0111\xE3 ghi l\u1EA1i m\u1ECDi vi\u1EC7c c\u1EA7n l\xE0m v\xE0o
    m\u1ED9t cu\u1ED1n s\u1ED5 \u2014 c\u1EADu s\u1EBD th\u1EA5y n\xF3 d\u01B0\u1EDBi
    d\u1EA1ng h\u1EC7 th\u1ED1ng nhi\u1EC7m v\u1EE5. Nhi\u1EC7m v\u1EE5 ch\xEDnh
    l\xE0 con \u0111\u01B0\u1EDDng d\u1EABn \u0111\u1EBFn l\u1EDDi h\u1EE9a v\u1EDBi
    tr\u01B0\u1EDFng l\xE0ng: x\xE2y l\u1EA1i l\xE0ng, \u0111\xE1nh tan b\u1ECDn
    c\u01B0\u1EDBp, m\u1EDF r\u1ED9ng \u0111\u1EA5t \u0111ai. Nhi\u1EC7m v\u1EE5
    ph\u1EE5 s\u1EBD l\xE0 nh\u1EEFng \u0111i\u1EC1u nh\u1ECF gi\xFAp c\u1EADu tr\xEAn
    \u0111\u01B0\u1EDDng \u0111i."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
