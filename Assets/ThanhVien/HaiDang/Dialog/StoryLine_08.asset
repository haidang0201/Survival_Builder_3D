  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_08
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Tr\u01B0\u1EDFng l\xE0ng"
  title: "Trao quy\u1EC1n"
  content: "\u201CTa \u0111\xE3 gi\xE0 r\u1ED3i\u2026 ng\xF4i l\xE0ng n\xE0y, ta
    giao l\u1EA1i cho con. H\xE3y ti\xEAu di\u1EC7t b\u1ECDn c\u01B0\u1EDBp, m\u1EDF
    r\u1ED9ng l\xE3nh th\u1ED5, mang l\u1EA1i b\xECnh y\xEAn cho d\xE2n l\xE0ng\u2026\u201D
    Gi\u1ECDng n\xF3i tr\u1EA7m, \xE1nh m\u1EAFt \u0111\u1EA7y k\u1EF3 v\u1ECDng.
    Ch\xE0ng trai g\u1EADt \u0111\u1EA7u, s\u1EB5n s\xE0ng nh\u1EADn tr\u1ECDng tr\xE1ch."
  portrait: {fileID: 0}
