  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_03
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Tr\u01B0\u1EDFng l\xE0ng"
  title: "Quy\u1EBFt \u1EDF l\u1EA1i - Kh\xF4ng b\u1ECF ch\u1EA1y n\u1EEFa"
  content: "Tr\u01B0\u1EDFng l\xE0ng gi\xE0 \u0111\u1EE9ng gi\u1EEFa qu\u1EA3ng tr\u01B0\u1EDDng,
    \xE1nh m\u1EAFt ki\xEAn c\u01B0\u1EDDng. D\xF9 n\u1ED7i s\u1EE3 h\xE3i v\u1EABn
    c\xF2n, \xF4ng quy\u1EBFt kh\xF4ng b\u1ECF l\xE0ng. Nh\u1EEFng ng\u01B0\u1EDDi
    d\xE2n xung quanh nh\xECn \xF4ng, d\u1EA5y l\xEAn ni\u1EC1m hi v\u1ECDng, b\u1EAFt
    \u0111\u1EA7u th\u1EAFp l\xEAn \xFD ch\xED t\u1EF1 b\u1EA3o v\u1EC7 qu\xEA h\u01B0\u01A1ng."
  portrait: {fileID: 0}
