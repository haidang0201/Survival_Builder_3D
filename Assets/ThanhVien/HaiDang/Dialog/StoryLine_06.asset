  m_Script: {fileID: 11500000, guid: c8f7f1121fcb9d247b3cb9bc6fa49988, type: 3}
  m_Name: StoryLine_06
  m_EditorClassIdentifier: Assembly-CSharp::StoryLineData
  speakerName: "Tr\u01B0\u1EDFng l\xE0ng"
  title: "B\u1ECDn c\u01B0\u1EDBp b\xF3c quay tr\u1EDF l\u1EA1i"
  content: "Nh\u1EEFng d\u1EA5u hi\u1EC7u b\u1EA5t th\u01B0\u1EDDng xu\u1EA5t hi\u1EC7n:
    b\u1ECDn c\u01B0\u1EDBp quay l\u1EA1i, th\xE1ch th\u1EE9c h\xF2a b\xECnh v\u1EEBa
    g\xE2y d\u1EF1ng. Tr\u01B0\u1EDFng l\xE0ng nghi\xEAm ngh\u1ECB, nh\u1EAFc d\xE2n
    l\xE0ng chu\u1EA9n b\u1ECB ph\xF2ng th\u1EE7, \xE1nh m\u1EAFt th\u1EC3 hi\u1EC7n
    quy\u1EBFt t\xE2m b\u1EA3o v\u1EC7 m\u1ECDi th\u1EE9 \u0111\xE3 x\xE2y d\u1EF1ng."
  portrait: {fileID: 0}
