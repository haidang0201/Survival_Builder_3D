  speakerName: "PH\xD3 L\xDD"
  title: "Ph\xF2ng th\u1EE7"
  content: "Nh\u01B0ng \u0111\u1EEBng qu\xEAn \u2014 b\u1ECDn c\u01B0\u1EDBp bo\xF3c
    c\xF3 th\u1EC3 quay l\u1EA1i b\u1EA5t c\u1EE9 l\xFAc n\xE0o, nh\u01B0 ch\xFAng
    \u0111\xE3 t\u1EEBng. Th\xE1p canh v\xE0 nh\u1EEFng ng\u01B0\u1EDDi l\xEDnh c\u1EADu
    b\u1ED1 tr\xED h\xF4m nay, ch\xEDnh l\xE0 \u0111i\u1EC1u gi\u1EEF cho ng\xE0y
    mai kh\xF4ng l\u1EB7p l\u1EA1i qu\xE1 kh\u1EE9."
  portrait: {fileID: 1871985265, guid: 05340f7438bce374e96af080bb0729ad, type: 3}
